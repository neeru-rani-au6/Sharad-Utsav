# MongoDB Atlas (or local) connection string — required on Vercel production
# Free cluster: https://www.mongodb.com/cloud/atlas
# Then run: pnpm db:seed
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Optional database name (default: sharad_utsav)
# MONGODB_DB=sharad_utsav
